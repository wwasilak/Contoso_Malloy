


source: currency_ex is duckdb.table('../Contoso_Malloy/ParquetFiles/currencyexchange.parquet')

source: customer is duckdb.table('../Contoso_Malloy/ParquetFiles/customer.parquet') extend {
    primary_key: CustomerKey

}
    
source: calendar is duckdb.table('../Contoso_Malloy/ParquetFiles//date.parquet') extend {
    primary_key: DateKey
}

source: store is duckdb.table('../Contoso_Malloy/ParquetFiles/store.parquet') extend {
    primary_key: StoreKey
}

source: product is duckdb.table('../Contoso_Malloy/ParquetFiles/product.parquet') extend {
    primary_key: ProductKey
}

source: orderrows is duckdb.table('../Contoso_Malloy/ParquetFiles/orderrows.parquet') extend {
    
    join_one: product with ProductKey

     dimension: 
     _Revenue is Quantity * NetPrice
     _Cost is Quantity * UnitCost  
}

source: orders is duckdb.table('../Contoso_Malloy/ParquetFiles/orders.parquet') extend {
    primary_key: OrderKey

    rename: OrderDate is DT

    join_many: orderrows on OrderKey = orderrows.OrderKey
    join_one: customer with CustomerKey
    join_one: store with StoreKey
    join_one: calendar on OrderDate = calendar.`Date`
    join_one: currency_ex on CurrencyCode = currency_ex.FromCurrency and OrderDate = currency_ex.`Date`
        and currency_ex.ToCurrency = 'USD'

    dimension: 
        _YearMonth is OrderDate.month
        _Year is OrderDate.year
        _Month is month(OrderDate)

    measure:
        Count_Orders is count()
        Total_Cost is orderrows._Cost.sum()
        Total_Sales is orderrows._Revenue.sum()
        Total_Sales_CY is Total_Sales {where: OrderDate ~ f'this year'}
        Total_Sales_PY is Total_Sales {where: OrderDate ~ f'last year'}
        Margin is Total_Sales - Total_Cost
        # percent
        Margin_Percent is Margin/Total_Sales



    view: v_YearMonth is {group_by: _YearMonth}

    view: v_YearMonthPY is {group_by: _YearMonth where: _Year ? now.year - 1 year}

    view: v_Category is {group_by: Category is orderrows.product.CategoryName}

    view: v_Subcategory is {group_by: Subategory is orderrows.product.SubCategoryName}

    view: v_MaxYear is {aggregate: Max_Year is max(OrderDate.year)}


    view: v_SalesMetrics is {
        aggregate:
             # number='0.0,,"M"' 
            Total_Sales_CY
            Margin_Percent
    }

    view: v_SalesByYear is v_YearMonth + v_SalesMetrics

   view: v_SalesByCategory is 
        v_Category + v_SalesMetrics 
        + {nest: 
            Details is v_Subcategory 
            + v_SalesMetrics
            + {order_by: Total_Sales_CY desc}
        }

    
-- not possible
    -- view: py_test is
    -- {
    --     aggregate: Total_Sales {where: OrderDate not  in (v_date_py)}
    -- }
    -- v_date_py + v_metrics_sales -> {aggregate: Total_Sales_py is Total_Sales.sum()}

    
}


source: sales is duckdb.table('../Contoso_Malloy/ParquetFiles/sales.parquet') extend {

    join_one: customer with CustomerKey
    join_one: store with StoreKey
    join_one: calendar on OrderDate = calendar.`Date`
}





run: orders -> v_Subcategory + v_SalesMetrics
 + {limit:10}
 + {
    # number='0.0,,"M"'
    aggregate:  Total_Sales_PY }


# dashboard
run: orders -> {
    nest: v_SalesMetrics
    nest: v_SalesByCategory
    nest: v_SalesByYear

}

run: orders -> {
    group_by:
    OrderKey
    OrderCurrency is CurrencyCode
    ExchangeRate is currency_ex.Exchange
        aggregate:     
    Total_Sales
    Converted_to_USD is Total_Sales * currency_ex.Exchange

}


