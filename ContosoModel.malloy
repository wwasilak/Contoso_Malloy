##! experimental.access_modifiers

source: currency_ex is duckdb.table('../Contoso_Malloy/ParquetFiles/currencyexchange.parquet')
include {
    public:
    `Date`
    Exchange
    FromCurrency
    ToCurrency
}

source: customer is duckdb.table('../Contoso_Malloy/ParquetFiles/customer.parquet') 
include {
    public:
    Age 
    Birthday
    City
    Company
    Continent
    Country
    CountryFull
    CustomerKey
    EndDT
    Gender
    GeoAreaKey
    GivenName
    Latitude
    Longitude
    MiddleInitial
    Occupation
    StartDT
    State
    StateFull
    StreetAddress
    Surname
    Title
    Vehicle
    ZipCode
}

extend {
    primary_key: CustomerKey

}
    
source: calendar is duckdb.table('../Contoso_Malloy/ParquetFiles//date.parquet') 
include {
    public:
    `Date`
    DateKey
    DayofWeek
    DayofWeekNumber
    DayofWeekShort
    `Month`
    MonthNumber
    MonthShort
    `Quarter`
    WorkingDay
    WorkingDayNumber
    `Year`
    YearMonth
    YearMonthNumber
    YearMonthShort
    YearQuarter
    YearQuarterNumber
}

extend {
    primary_key: DateKey
}

source: store is duckdb.table('../Contoso_Malloy/ParquetFiles/store.parquet') 
include {
    public:
    CloseDate
    CountryCode
    CountryName
    Description
    GeoAreaKey
    OpenDate
    SquareMeters
    State
    Status
    StoreCode
    StoreKey
}

extend {
    primary_key: StoreKey
}

source: product is duckdb.table('../Contoso_Malloy/ParquetFiles/product.parquet') 

include {
    public:
    Brand
    CategoryKey
    CategoryName
    Color
    Cost
    Manufacturer
    Price 
    ProductKey
    ProductCode
    ProductName
    SubCategoryName
    SubCategoryKey
    Weight
    WeightUnit
}

extend {
    primary_key: ProductKey
}

source: orderrows is duckdb.table('../Contoso_Malloy/ParquetFiles/orderrows.parquet') 

include {
    public:
    NetPrice
    OrderKey
    ProductKey
    Quantity
    RowNumber
    UnitCost
    UnitPrice
}

extend {
    
    join_one: product with ProductKey

     dimension: 
     _Revenue is Quantity * NetPrice
     _Cost is Quantity * UnitCost  
}

source: orders is duckdb.table('../Contoso_Malloy/ParquetFiles/orders.parquet') 

include {
    public:
    CurrencyCode
    CustomerKey
    DeliveryDate
    DT
    OrderKey
    StoreKey
}

extend {
    primary_key: OrderKey

    -- rename: DT is DT

    join_many: orderrows on OrderKey = orderrows.OrderKey
    join_one: customer with CustomerKey
    join_one: store with StoreKey
    join_one: calendar on DT = calendar.`Date`
    join_one: currency_ex on CurrencyCode = currency_ex.FromCurrency and DT = currency_ex.`Date`
        and currency_ex.ToCurrency = 'USD'

    dimension: 
        _YearMonth is DT.month
        _Year is DT.year
        _Month is month(DT)

    measure:
        Count_Orders is count()
        Total_Cost is orderrows._Cost.sum()
        Total_Sales is orderrows._Revenue.sum()
        Total_Sales_CY is Total_Sales {where: DT ~ f'this year'}
        Total_Sales_PY is Total_Sales {where: DT ~ f'last year'}
        Margin is Total_Sales - Total_Cost
        # percent
        Margin_Percent is Margin/Total_Sales



    view: v_YearMonth is {group_by: _YearMonth}

    view: v_YearMonthPY is {group_by: _YearMonth where: _Year ? now.year - 1 year}

    view: v_Category is {group_by: Category is orderrows.product.CategoryName}

    view: v_Subcategory is {group_by: Subategory is orderrows.product.SubCategoryName}

    view: v_MaxYear is {aggregate: Max_Year is max(DT.year)}


    view: v_SalesMetrics is {
        aggregate:
             # number='0.0,,"M"' 
            Total_Sales_CY
            Margin_Percent
    }

    view: v_SalesByYear is v_YearMonth + v_SalesMetrics

   view: v_SalesByCategory is 
        v_Category + v_SalesMetrics 
        + {nest: 
            Details is v_Subcategory 
            + v_SalesMetrics
            + {order_by: Total_Sales_CY desc}
        }

    
}


source: sales is duckdb.table('../Contoso_Malloy/ParquetFiles/sales.parquet') extend {

    join_one: customer with CustomerKey
    join_one: store with StoreKey
    join_one: calendar on  OrderDate = calendar.`Date`
}





run: orders -> v_Subcategory + v_SalesMetrics
 + {limit:10}
 + {
    # number='0.0,,"M"'
    aggregate:  Total_Sales_PY }


# dashboard
run: orders -> {
    nest: v_SalesMetrics
    nest: v_SalesByCategory
    nest: v_SalesByYear

}

run: orders -> {
    group_by:
    OrderKey
    OrderCurrency is CurrencyCode
    ExchangeRate is currency_ex.Exchange
        aggregate:     
    Total_Sales
    Converted_to_USD is Total_Sales * currency_ex.Exchange

}





