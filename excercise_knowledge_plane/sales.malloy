##! experimental.access_modifiers

// =============================================================================
// SALES MODEL — multi-model variant. Links only; definitions live in the KP.
// =============================================================================
# model = "sales"

// ---------- CURRENCY EXCHANGE RATE ----------
# concept = "kp:CurrencyExchangeRate"
source: currency_exchange_rate is duckdb.table('../Contoso_Malloy/ParquetFiles/currencyexchange.parquet')
  include {
    internal: FromCurrency, ToCurrency, `Date`
    public: Exchange
  }

// ---------- CUSTOMER ----------
# concept = "kp:Customer"
source: customer is duckdb.table('../Contoso_Malloy/ParquetFiles/customer.parquet')
  include {
    internal:  GeoAreaKey
    public:
    # concept = "kp:CustomerAge"
    Age
    # concept = "kp:CustomerGender"
    Gender
    # concept = "kp:CustomerOccupation"
    Occupation
    # concept = "kp:CustomerCountry"
    Country
    # concept = "kp:CustomerCity"
    City
    CustomerKey,
    Birthday, Company, Continent, CountryFull, EndDT, GivenName, Latitude,
    Longitude, MiddleInitial, StartDT, State, StateFull, StreetAddress,
    Surname, Title, Vehicle, ZipCode
  } 
  extend {
    primary_key: CustomerKey
  }

// ---------- CALENDAR DATE ----------
# concept = "kp:CalendarDate"
source: calendar_date is duckdb.table('../Contoso_Malloy/ParquetFiles/date.parquet')
  include {
    internal: DateKey
    public:
    `Date`, DayofWeek, DayofWeekNumber, DayofWeekShort, `Month`, MonthNumber,
    MonthShort, `Quarter`, WorkingDay, WorkingDayNumber, `Year`, YearMonth,
    YearMonthNumber, YearMonthShort, YearQuarter, YearQuarterNumber
  } 
  extend {
    primary_key: DateKey
  }

// ---------- STORE ----------
# concept = "kp:Store"
source: store is duckdb.table('../Contoso_Malloy/ParquetFiles/store.parquet')
  include {
    internal: StoreKey, GeoAreaKey
    public:
    # concept = "kp:StoreCountry"
    CountryName

    CloseDate, CountryCode, Description, OpenDate, SquareMeters, State,
    Status, StoreCode
  } 
  extend {
    primary_key: StoreKey
  }

// ---------- PRODUCT ----------
# concept = "kp:Product"
source: product is duckdb.table('../Contoso_Malloy/ParquetFiles/product.parquet')
  include {
    internal: ProductKey, CategoryKey, SubCategoryKey
    public:
    # concept = "kp:ProductBrand"
    Brand
    # concept = "kp:ProductCategory"
    CategoryName
    # concept = "kp:ProductUnitCost"
    Cost
    # concept = "kp:ProductUnitPrice"
    Price

    Color, Manufacturer, ProductCode, ProductName, SubCategoryName,
    Weight, WeightUnit
  } 
  extend {
    primary_key: ProductKey
  }

// ---------- ORDER LINE ----------
# concept = "kp:OrderLine"
source: order_line is duckdb.table('../Contoso_Malloy/ParquetFiles/orderrows.parquet')
  include {
    internal: OrderKey, ProductKey, RowNumber, UnitPrice
    public:
    # concept = "kp:LineQuantity"
    Quantity

    NetPrice, UnitCost
  }

// ---------- ORDER ----------
# concept = "kp:Order"
source: order is duckdb.table('../Contoso_Malloy/ParquetFiles/orders.parquet')
  include {
    internal: OrderKey, StoreKey, CurrencyCode
    public:
    # concept = "kp:OrderDate"
    DT

    DeliveryDate, CustomerKey
  } 
  extend {
    primary_key: OrderKey
  }


// =============================================================================
// EXTENDED LAYER — named relationships + measures
// =============================================================================


// ---------- CUSTOMER_ORDER_IN_CONTEXT ----------
# concept = "kp:Customer"
source: customer_order_in_context is customer extend {
  join_many: made_an_order is order on made_an_order.CustomerKey = CustomerKey

  measure:
  # concept = "kp:ActiveCustomer"
  is_active_customer is made_an_order.count() { where: made_an_order.DT ~ f'last 2 years' } > 0
}


// ---------- ORDER_LINE_IN_CONTEXT ----------

# concept = "kp:OrderLine"
source: order_line_in_context is order_line extend {

  # is_about_role = "kp:recordsSaleOf"
  join_one: sold_product is product with ProductKey

  dimension:
  # concept = "kp:LineRevenue"
  line_revenue is (Quantity * NetPrice)
  # concept = "kp:LineCost"
  line_cost is (Quantity * UnitCost)
}


// ---------- SALES_ORDER ----------
# concept = "kp:Order"
source: sales_order is order extend {

  # is_about_role = "kp:isPlacedBy"
  join_one: placed_by is customer with CustomerKey
  # is_about_role = "kp:isPlacedAt"
  join_one: placed_at is store with StoreKey
  # is_about_role = "kp:occursOn"
  join_one: occurs_on is calendar_date on DT = occurs_on.`Date`
  # is_about_role = "kp:consistsOf"
  join_many: lines is order_line_in_context on OrderKey = lines.OrderKey

  measure:
  # concept = "kp:OrderCount"
  order_count is count()
  # concept = "kp:TotalSales"
  total_sales is lines.line_revenue.sum()
  # concept = "kp:TotalCost"
  total_cost is lines.line_cost.sum()
  # concept = "kp:Margin"
  margin is total_sales - total_cost
  # concept = "kp:MarginPercent"
  margin_percent is margin / total_sales
}
