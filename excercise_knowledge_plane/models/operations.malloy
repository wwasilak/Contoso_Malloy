
##! experimental.access_modifiers experimental.parameters

// =============================================================================
// OPERATIONS MODEL — fulfillment & store productivity. Imports the shared base.
// Links only; concept definitions live in the Knowledge Plane (MOTLY).
// =============================================================================
import "base.malloy"

// ---------- OPERATIONS_ORDER — fulfillment on top of the core order fact ------
# model = "operations"
# concept = "kp:Order"
source: operations_order(reporting_currency::string is "USD") is
  sales_order(reporting_currency is reporting_currency) extend {

  dimension:
  # concept = "kp:DeliveryDays"
  delivery_days is days(DT to DeliveryDate)

  measure:
  # concept = "kp:AvgDeliveryDays"
  avg_delivery_days is avg(delivery_days)
  # concept = "kp:DeliveredWithin3DaysRate"
  delivered_within_3d_rate is count() { where: delivery_days <= 3 } / count()
}

// ---------- STORE_PORTFOLIO — store-centric productivity ----------------------
# concept = "kp:Store"
source: store_portfolio(reporting_currency::string is "USD") is store extend {

  # is_about_role = "kp:isPlacedAt"
  join_many: fulfilled_orders is sales_order(reporting_currency is reporting_currency)
    on fulfilled_orders.StoreKey = StoreKey

  dimension:
  # concept = "kp:StoreSquareMeters"
  square_meters is SquareMeters
  # concept = "kp:StoreStatus"
  store_status is Status
  # concept = "kp:StoreOpenDate"
  store_open_date is OpenDate

  measure:
  # concept = "kp:StoreCount"
  store_count is count()
  # concept = "kp:ActiveStoreCount"
  active_store_count is count() { where: Status != 'Closed' }
  # concept = "kp:TotalSales"
  total_sales is fulfilled_orders.total_sales
  # concept = "kp:SalesPerSquareMeter"
  sales_per_square_meter is fulfilled_orders.total_sales / SquareMeters.sum()
}
