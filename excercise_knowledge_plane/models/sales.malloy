##! experimental.access_modifiers experimental.parameters

// =============================================================================
// SALES MODEL — sales-performance KPIs. Imports the shared base and extends
// the core order fact; defines NO plumbing of its own.
// Links only; concept definitions live in the Knowledge Plane (MOTLY).
// =============================================================================
import "base.malloy"

// ---------- SALES_PERFORMANCE — basket & volume KPIs on top of sales_order ----
# model = "sales"
# concept = "kp:Order"
source: sales_performance(reporting_currency::string is "USD") is
  sales_order(reporting_currency is reporting_currency) extend {

  measure:
  # concept = "kp:TotalUnits"
  total_units is lines.Quantity.sum()
  # concept = "kp:LineCount"
  line_count is lines.count()
  # concept = "kp:AverageOrderValue"
  average_order_value is total_sales / order_count
  # concept = "kp:UnitsPerOrder"
  units_per_order is total_units / order_count
}
