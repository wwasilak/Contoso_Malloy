
-- base sources

# description = "A natural or legal person who buys products from the company."
# business_owner = "Sales"
source: customer is duckdb.table('../Contoso_Malloy/ParquetFiles/customer.parquet') extend {
  primary_key: CustomerKey
}

# description = "A calendar date. Used as the temporal anchor for orders, exchange rates and reporting periods."
# business_owner = "Finance"
source: calendar_date is duckdb.table('../Contoso_Malloy/ParquetFiles/date.parquet') extend {
  primary_key: DateKey
}

# description = "A physical or online point of sale where orders are placed."
# business_owner = "Retail Operations"
source: store is duckdb.table('../Contoso_Malloy/ParquetFiles/store.parquet') extend {
  primary_key: StoreKey
}

# description = "A sellable item offered to customers, identified by a stable product key."
# business_owner = "Merchandising"
source: product is duckdb.table('../Contoso_Malloy/ParquetFiles/product.parquet') extend {
  primary_key: ProductKey
}

# description = "The daily exchange rate from one currency to another, used to convert transactional amounts into a reporting currency."
# business_owner = "Finance"
source: currency_exchange_rate is duckdb.table('../Contoso_Malloy/ParquetFiles/currencyexchange.parquet')

# description = "A single line on an order, recording one product, its quantity and the prices applied at the time of sale."
# synonym = "order line"
# business_owner = "Sales"
source: order_line is duckdb.table('../Contoso_Malloy/ParquetFiles/orderrows.parquet')

# description = "A purchase transaction placed by a customer at a store on a given date, composed of one or more order lines."
# business_owner = "Sales"
source: order is duckdb.table('../Contoso_Malloy/ParquetFiles/orders.parquet') extend {
  primary_key: OrderKey
  rename: order_date is DT
}

-- extended sources

# description = "An order line enriched with the product that was sold. Use this when you need product context for line-level analysis."
source: order_line_with_context is order_line extend {

    # description = "The product that was sold on this line."
    # relationship = "records sale of"
    join_one: sold_product is product with ProductKey

    # description = "Gross revenue for this line: quantity multiplied by net price, in the transaction currency."
    dimension: line_revenue is (Quantity * NetPrice)

    # description = "Cost of goods sold for this line: quantity multiplied by unit cost, in the transaction currency."
    line_cost is (Quantity * UnitCost)
}

# description = "An order enriched with its customer, store, date, currency conversion and lines. This is the primary analytical view for sales reporting."
source: sales_order is order extend {

    # description = "The customer who placed this order."
    # relationship = "is placed by"
    join_one: placed_by is customer with CustomerKey

    # description = "The store where this order was placed."
    # relationship = "is placed at"
    join_one: placed_at is store with StoreKey

    # description = "The calendar date on which this order was placed."
    # relationship = "occurs on"
    join_one: occurs_on is calendar_date on order_date = occurs_on.`Date`

    # description = "The USD exchange rate applicable to this order's currency on its order date."
    # relationship = "is converted using"
    join_one: usd_conversion is currency_exchange_rate on
        CurrencyCode = usd_conversion.FromCurrency
        and order_date = usd_conversion.`Date`
        and usd_conversion.ToCurrency = 'USD'

    # description = "The individual lines that make up this order."
    # relationship = "consists of"
    join_many: lines is order_line_with_context on OrderKey = lines.OrderKey



    # description = "Calendar year of the order date."
    dimension: order_year is order_date.year

    # description = "Calendar month of the order date."
    dimension: order_month is order_date.month

  // -------- Miary biznesowe --------

  # description = "Number of distinct orders in the selected scope."
    measure: order_count is count()

    # description = "Total gross sales in transaction currency: sum of line revenues across all lines of all orders in scope."
    measure: total_sales is lines.line_revenue.sum()

    # description = "Total cost of goods sold in transaction currency: sum of line costs across all lines of all orders in scope."
    measure: total_cost is lines.line_cost.sum()

    # description = "Total gross sales for orders placed in the current calendar year."
    measure: total_sales_current_year is total_sales {where: order_date ~ f'this year'}

    # description = "Total gross sales for orders placed in the previous calendar year. Use together with total_sales_current_year for year-over-year comparison."
    measure: total_sales_previous_year is total_sales {where: order_date ~ f'last year'}

    # description = "Gross margin: total sales minus total cost, in transaction currency."
    measure: margin is total_sales - total_cost

    # percent
    # description = "Gross margin as a percentage of total sales. Expressed as a ratio between 0 and 1."
    measure: margin_percent is margin / total_sales
}