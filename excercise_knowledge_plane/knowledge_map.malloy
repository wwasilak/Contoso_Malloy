--created entirely with Claude

// =============================================================================
// knowledge_plane.malloy
// -----------------------------------------------------------------------------
// The Knowledge Plane, exposed as a Malloy model so an AI agent can query it
// through the same Malloy/Publisher MCP it already uses for data — no separate
// triplestore required.
//
// The source file is knowledge_plane.ttl (RDF/Turtle). Raw RDF is a flat list
// of (subject, predicate, object) triples; querying that directly is painful.
// So each source below PIVOTS the triples into a wide, named table that matches
// how the concept actually looks. An agent should read these four sources, not
// raw triples.
//
// HOW TO USE (for an agent):
//   - `concepts`      : every business concept — its kind, label, definition.
//   - `relationships` : how concepts connect (verb, domain entity, range entity).
//   - `concept_attributes` : which attributes belong to which entity.
//   - `data_bindings` : which Malloy source in which model realises a concept.
//   Start from `concepts` to learn vocabulary, then `relationships` to navigate,
//   then `data_bindings` to find the executable source to query for real data.
// =============================================================================
// Requires the DuckDB 'rdf' community extension (provides read_rdf()).



##! experimental.access_modifiers
// ---------------------------------------------------------------------------
// CONCEPTS — the business vocabulary.
// One row per concept. `concept_kind` is the most important column: it tells
// the agent whether this is an entity (a thing), an attribute (a property of a
// thing), a measure (a computed number), or a defined_class (a subset with a
// membership rule).
// ---------------------------------------------------------------------------
# concept_kind { description = "entity | attribute | measure | defined_class" }
source: concepts is duckdb.sql("""
  WITH t AS (SELECT subject, predicate, object
             FROM read_rdf('excercise_knowledge_plane/knowledge_plane.ttl'))
  SELECT
    replace(s.subject, 'https://yourorg.example/kp#', 'kp:')      AS concept_uri,
    kind.object                                                  AS concept_kind,
    lbl.object                                                   AS label,
    def.object                                                   AS definition,
    stw.object                                                   AS steward,
    replace(sup.object, 'https://yourorg.example/kp#', 'kp:')     AS subtype_of,
    mem.object                                                   AS membership_rule
  FROM (SELECT DISTINCT subject FROM t WHERE predicate LIKE '%conceptKind') s
  LEFT JOIN t kind ON kind.subject = s.subject AND kind.predicate LIKE '%conceptKind'
  LEFT JOIN t lbl  ON lbl.subject  = s.subject AND lbl.predicate  LIKE '%prefLabel'
  LEFT JOIN t def  ON def.subject  = s.subject AND def.predicate  LIKE '%definition'
  LEFT JOIN t stw  ON stw.subject  = s.subject AND stw.predicate  LIKE '%steward'
  LEFT JOIN t sup  ON sup.subject  = s.subject AND sup.predicate  LIKE '%subClassOf'
  LEFT JOIN t mem  ON mem.subject  = s.subject AND mem.predicate  LIKE '%membershipRule'
""") 

include {
  public:
  # description = "Stable URI of the concept; used as the join key everywhere."
  concept_uri

  # description = "Human-readable name of the concept."
  label

  # description = "Plain-language business definition. The agent should treat this as authoritative."
  definition

  # description = "Business owner accountable for this concept's meaning. Null for attributes/measures."
  steward

  # description = "For defined_class concepts: the parent entity it is a subset of."
  subtype_of

  # description = "For defined_class concepts: the necessary-and-sufficient rule for membership."
  membership_rule

  # description = "Classifies each concept as one of four types"
  concept_kind
}
extend {
 measure:
  # description = "How many concepts of each kind exist."
  concept_count is count()

  # description = "All concepts grouped by kind — a quick overview of the vocabulary."
  view: overview is {
    group_by: concept_kind
    aggregate: concept_count
  }
  # description = "Full glossary: every concept with its definition, ordered by kind."
  view: glossary is {
    group_by: concept_kind, concept_uri, label, definition, steward
    order_by: concept_kind, concept_uri
  }
  # description = "Only defined classes — concepts with an operational membership rule."
  view: defined_classes is {
    where: concept_kind = 'defined_class'
    group_by: concept_uri, label, definition, subtype_of, membership_rule
  }
}


// ---------------------------------------------------------------------------
// RELATIONSHIPS — how entities connect.
// One row per relationship. Read as a sentence: <domain> <label> <range>,
// e.g. "Order is placed by Customer".
// ---------------------------------------------------------------------------
source: relationships is duckdb.sql("""
  WITH t AS (SELECT subject, predicate, object
             FROM read_rdf('excercise_knowledge_plane/knowledge_plane.ttl'))
  SELECT
    replace(s.subject, 'https://yourorg.example/kp#', 'kp:')   AS relationship_uri,
    lbl.object                                                 AS verb,
    replace(dom.object, 'https://yourorg.example/kp#', 'kp:')  AS domain_concept,
    replace(rng.object, 'https://yourorg.example/kp#', 'kp:')  AS range_concept
  FROM (SELECT DISTINCT subject FROM t
        WHERE object = 'http://www.w3.org/2002/07/owl#ObjectProperty') s
  LEFT JOIN t lbl ON lbl.subject = s.subject AND lbl.predicate LIKE '%label'
  LEFT JOIN t dom ON dom.subject = s.subject AND dom.predicate LIKE '%domain'
  LEFT JOIN t rng ON rng.subject = s.subject AND rng.predicate LIKE '%range'
""") 
include {
  public:
  # description = "Stable URI of the relationship."
  relationship_uri
  # description = "The relationship as a verb phrase, e.g. 'is placed by'."
  verb
  # description = "The entity the relationship starts from (the subject of the sentence)."
  domain_concept
  # description = "The entity the relationship points to (the object of the sentence)."
  range_concept
}
extend {
  # description = "The relationship as a readable sentence: domain + verb + range."
  dimension: as_sentence is concat(domain_concept, ' ', verb, ' ', range_concept)

  measure: relationship_count is count()

  # description = "All relationships as readable sentences — the map of how entities connect."
  view: all_relationships is {
    group_by: as_sentence, relationship_uri
    order_by: as_sentence
  }
}

// ---------------------------------------------------------------------------
// CONCEPT ATTRIBUTES — which attributes belong to which entity.
// One row per (entity, attribute) pair. Lets the agent answer
// "what do we know about a Customer?" without scanning raw triples.
// ---------------------------------------------------------------------------
source: concept_attributes is duckdb.sql("""
  WITH t AS (SELECT subject, predicate, object
             FROM read_rdf('excercise_knowledge_plane/knowledge_plane.ttl'))
  SELECT
    replace(subject, 'https://yourorg.example/kp#', 'kp:') AS entity_concept,
    replace(object,  'https://yourorg.example/kp#', 'kp:') AS attribute_concept
  FROM t WHERE predicate LIKE '%hasAttribute'
""") 
include {
  public:
  # description = "The entity that owns the attribute."
  entity_concept
  # description = "An attribute concept belonging to that entity."
  attribute_concept
}
extend {
  measure: attribute_count is count()

  # description = "Attributes grouped per entity — what is known about each thing."
  view: attributes_per_entity is {
    group_by: entity_concept
    aggregate: attribute_count
    nest: attributes is { group_by: attribute_concept }
  }
}

// ---------------------------------------------------------------------------
// DATA BINDINGS — the bridge to the Data Plane.
// One row per (Malloy source -> concept) link. This is what tells the agent
// WHERE to actually run a query: given a concept, which executable Malloy
// source in which model represents it. Note one concept can have several
// bindings (e.g. kp:Customer is realised by more than one source).
// ---------------------------------------------------------------------------
source: data_bindings is duckdb.sql("""
  WITH t AS (SELECT subject, predicate, object
             FROM read_rdf('excercise_knowledge_plane/knowledge_plane.ttl'))
  SELECT
    replace(object, 'https://yourorg.example/kp#', 'kp:')   AS concept_uri,
    split_part(replace(subject, 'https://yourorg.example/dp/', ''), '#', 1) AS model,
    split_part(replace(subject, 'https://yourorg.example/dp/', ''), '#', 2) AS malloy_source
  FROM t WHERE predicate LIKE '%isAbout'
""") 
include {
  public:
  # description = "The concept this Malloy source is about."
  concept_uri
  # description = "Which Malloy model the source lives in."
  model
  # description = "The executable Malloy source name to query for real data about this concept."
  malloy_source
}
extend {
  measure: binding_count is count()

  # description = "For each concept, the Malloy sources that realise it (where to run queries)."
  view: bindings_per_concept is {
    group_by: concept_uri
    aggregate: binding_count
    nest: sources is { group_by: model, malloy_source }
  }
}
